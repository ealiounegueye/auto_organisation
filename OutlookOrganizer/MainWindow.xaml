<Window x:Class="OutlookOrganizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Outlook Organizer"
        Height="640"
        Width="460"
        MinHeight="520"
        MinWidth="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}"
        FontFamily="Segoe UI"
        Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Margin="24" Padding="28" Background="{StaticResource CardBackground}" CornerRadius="12"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE715;" FontSize="28"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="OUTLOOK ORGANIZER" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="{Binding Headline}" FontSize="16" FontWeight="SemiBold"
                           TextAlignment="Center" Foreground="{StaticResource TextPrimary}"
                           Margin="0,8,0,6" TextWrapping="Wrap" />

                <TextBlock Text="{Binding Account}" FontSize="13" TextAlignment="Center"
                           Foreground="{StaticResource TextSecondary}" Margin="0,0,0,16" TextWrapping="Wrap" />

                <ProgressBar Height="6" IsIndeterminate="True" Margin="0,0,0,16"
                             Visibility="{Binding IsBusy, Converter={StaticResource VisibleIfTrue}}" />

                <TextBlock Text="{Binding StatusMessage}" FontSize="13"
                           Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,16" />

                <TextBlock Text="{Binding SummaryText}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" Margin="0,0,0,14"
                           Visibility="{Binding HasAnalysis, Converter={StaticResource VisibleIfTrue}}"
                           TextWrapping="Wrap" />

                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{Binding Color}"
                                         VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14"
                                           Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="14"
                                           FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="Fermer" Style="{StaticResource PrimaryButton}"
                        Command="{Binding CloseCommand}" Margin="0,16,0,0"
                        IsEnabled="{Binding CanClose}" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
