<Window x:Class="OutlookOrganizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Outlook Organizer"
        Height="760"
        Width="480"
        MinHeight="680"
        MinWidth="440"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}"
        FontFamily="Segoe UI"
        Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Margin="24" Padding="28" Background="{StaticResource CardBackground}" CornerRadius="12"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE715;" FontSize="28"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="OUTLOOK ORGANIZER" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="Organisez automatiquement votre boîte Microsoft 365"
                           TextAlignment="Center" Foreground="{StaticResource TextSecondary}"
                           FontSize="13" Margin="0,0,0,18" TextWrapping="Wrap" />

                <Border Background="{StaticResource SimulationBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,18">
                    <StackPanel>
                        <CheckBox Content="Mode simulation"
                                  IsChecked="{Binding IsSimulationMode, Mode=TwoWay}"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource SimulationText}" />
                        <TextBlock Text="{Binding SimulationBannerText}"
                                   Foreground="{StaticResource SimulationText}"
                                   FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Votre compte" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                <TextBlock Text="{Binding Account}" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}" Margin="0,2,0,12" TextWrapping="Wrap" />

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Se connecter" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SignInCommand}"
                            Visibility="{Binding IsSignedOut, Converter={StaticResource VisibleIfTrue}}" />
                    <Button Grid.Column="0" Content="Déconnexion" Style="{StaticResource SecondaryButton}"
                            Command="{Binding SignOutCommand}"
                            Visibility="{Binding IsSignedIn, Converter={StaticResource VisibleIfTrue}}" />
                    <Button Grid.Column="2" Content="Analyser ma boîte" Style="{StaticResource PrimaryButton}"
                            Command="{Binding AnalyzeCommand}" />
                </Grid>

                <TextBlock Text="{Binding SummaryText}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" Margin="0,0,0,14" TextWrapping="Wrap" />

                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{Binding Color}"
                                         VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14"
                                           Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="Organiser" Style="{StaticResource PrimaryButton}"
                        Command="{Binding OrganizeCommand}" Margin="0,10,0,16" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                            Visibility="{Binding IsBusy, Converter={StaticResource VisibleIfTrue}}">
                    <ProgressBar IsIndeterminate="True" Height="4" Width="120" />
                </StackPanel>

                <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                           Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
